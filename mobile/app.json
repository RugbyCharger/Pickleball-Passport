{
  "expo": {
    "name": "Pickleball Passport",
    "slug": "pickleball-passport",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "pickleballpassport",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pickleballpassport.app",
      "buildNumber": "1",
      "associatedDomains": [
        "applinks:pickleballpassport.com",
        "webcredentials:pickleballpassport.com"
      ],
      "infoPlist": {
        "UIBackgroundModes": ["remote-notification"]
      },
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": []
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.pickleballpassport.app",
      "versionCode": 1,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "pickleballpassport.com",
              "pathPrefix": "/app"
            },
            {
              "scheme": "https",
              "host": "pickleballpassport.com",
              "pathPrefix": "/trip"
            },
            {
              "scheme": "https",
              "host": "pickleballpassport.com",
              "pathPrefix": "/alumni"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      ["onesignal-expo-plugin", { "mode": "production", "devTeam": "APPLE_TEAM_ID_PLACEHOLDER" }],
      "expo-router",
      "expo-secure-store"
    ],
    "extra": {
      "oneSignalAppId": "${EXPO_PUBLIC_ONESIGNAL_APP_ID}"
    },
    "experiments": {
      "typedRoutes": true
    }
  }
}
