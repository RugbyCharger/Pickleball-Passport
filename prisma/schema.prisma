// Pickleball Passport Database Schema
// Generated: 2025-12-28
// Database: PostgreSQL (Supabase)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================================================
// ENUMS
// ============================================================================

enum Role {
  GUEST
  PARTNER
  ADMIN
}

enum BookingStatus {
  DRAFT           // User is configuring package
  PENDING_PAYMENT // Booking created, awaiting payment
  CONFIRMED       // Payment received, booking confirmed
  CANCELLED       // Booking cancelled
  COMPLETED       // Trip completed
}

enum PaymentStatus {
  PENDING   // Payment not yet processed
  SUCCEEDED // Payment successful
  FAILED    // Payment failed
  REFUNDED  // Payment refunded
}

enum ApplicationStatus {
  SUBMITTED // Application submitted by guest
  REVIEWING // Admin is reviewing
  APPROVED  // Application approved
  REJECTED  // Application rejected
}

enum PartnerTier {
  BRONZE
  SILVER
  GOLD
  PLATINUM
}

enum NotificationType {
  BOOKING_CONFIRMATION
  PAYMENT_RECEIPT
  TRIP_REMINDER
  GENERAL
  // Partner notifications (E11-S9)
  REFERRAL_CLICK
  REFERRAL_APPLICATION
  REFERRAL_BOOKING
  POINTS_EARNED
  TIER_CHANGE
  COMMISSION_AVAILABLE
}

enum DocumentType {
  PASSPORT
  MEDICAL_FORM
  INSURANCE
  VISA
  OTHER
}

enum DocumentStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
  EXPIRED
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum ForumCategory {
  BEST_PRACTICES
  SUCCESS_STORIES
  Q_AND_A
  ANNOUNCEMENTS
}

enum AddOnCategory {
  DENTAL
  FACIAL_COSMETIC
  BODY
  HEALTH_SCREENING
  SPA
  YOGA_MEDITATION
  CULTURAL
  PICKLEBALL
}

enum PickleballSkillLevel {
  RECREATIONAL
  INTERMEDIATE
  ADVANCED
}

enum SubscriberStatus {
  PENDING
  ACTIVE
  UNSUBSCRIBED
  BOUNCED
}

enum GiftStatus {
  PENDING   // Payment complete, waiting to send notification
  SENT      // Gift notification email sent to recipient
  ACCEPTED  // Recipient accepted gift, booking transferred
  DECLINED  // Recipient declined gift, refund processed
}

enum TaskPriority {
  URGENT
  IMPORTANT
  NORMAL
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

enum PaymentPlan {
  FULL          // Pay in full (2% discount)
  INSTALLMENT_4 // 4 payments (50%, 25%, 15%, 10%)
  FINANCING     // Affirm financing (future)
}

enum PaymentRecordStatus {
  PAID    // Payment completed successfully
  PENDING // Payment scheduled but not yet processed
  FAILED  // Payment attempt failed
}

// ============================================================================
// USER & AUTHENTICATION
// ============================================================================

model User {
  id        String   @id // Clerk user ID
  email     String   @unique
  role      Role     @default(GUEST)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Stripe Integration (E4-S6)
  stripeCustomerId String? // Stripe customer ID for installment plans

  // Relationships
  guestProfile   GuestProfile?
  partnerProfile PartnerProfile?
  applications   Application[]
  bookings       Booking[]
  notifications  Notification[]
  testimonials   Testimonial[]

  @@index([email])
  @@index([role])
  @@index([stripeCustomerId])
}

// ============================================================================
// GUEST PROFILE
// ============================================================================

model GuestProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Personal Information
  firstName String
  lastName  String
  phone     String?
  age       Int?
  location  String? // City, Country

  // Pickleball Background
  pickleballSkillLevel PickleballSkillLevel? // Enum: RECREATIONAL, INTERMEDIATE, ADVANCED
  pickleballFrequency  String? // e.g., "3x per week"
  homeClub             String?

  // Health & Dietary
  dietaryRestrictions String[] // Array of restrictions
  allergies           String?
  medicalNotes        String? // Private medical info

  // Emergency Contact
  emergencyContactName         String?
  emergencyContactPhone        String?
  emergencyContactRelationship String?

  // Profile Completion Status
  profileCompleted Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// ============================================================================
// PARTNER PROFILE
// ============================================================================

model PartnerProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Club Information
  clubName     String
  clubLocation String
  jobTitle     String?

  // Partner Program
  referralCode  String        @unique // e.g., "VILLAGES-JEN-2025"
  tier          PartnerTier   @default(BRONZE)
  passportPoints Int          @default(0)
  onboardingCompleted Boolean @default(false) // E9-S14: Onboarding wizard

  // Notification Preferences (E11-S9)
  notificationPreferences Json? // {emailReferralClicks, emailApplications, emailBookings, etc.}

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  referrals PartnerReferral[]
  landingPages PartnerLandingPage[]
  payouts PartnerPayout[]
  payoutMethod PartnerPayoutMethod?
  forumThreads ForumThread[]
  forumReplies ForumReply[]
  forumLikes ForumLike[]
  forumReplyLikes ForumReplyLike[]

  @@index([userId])
  @@index([referralCode])
  @@index([tier])
}

// ============================================================================
// PACKAGES & TRIPS
// ============================================================================

model Package {
  id          String   @id @default(cuid())
  slug        String   @unique // URL-friendly name
  name        String   // e.g., "Pure Play", "Smile Makeover"
  tagline     String?
  description String   @db.Text // Markdown content

  // Pricing
  basePrice Int // Base price in USD cents (e.g., 1500000 = $15,000)

  // Duration Options
  durationOptions Int[] // Array of days: [7, 10, 14, 21]

  // Media
  heroImageUrl String?
  imageUrls    String[] // Gallery images

  // SEO
  metaTitle       String?
  metaDescription String?

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  bookings    Booking[]
  itineraries Itinerary[]

  @@index([slug])
  @@index([isActive])
}

model Itinerary {
  id        String @id @default(cuid())
  packageId String
  package   Package @relation(fields: [packageId], references: [id], onDelete: Cascade)

  duration Int // Number of days (7, 10, 14, 21)

  // Day-by-day content (JSON or separate ItineraryDay model)
  content String @db.Text // JSON: [{ day: 1, title: "Arrival", activities: [...] }]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([packageId])
  @@index([duration])
}

model Trip {
  id          String   @id @default(cuid())
  name        String   // e.g., "Phuket January 2026"
  destination String   // Thailand location

  // Dates
  startDate DateTime
  endDate   DateTime

  // Capacity
  capacity        Int // Max guests (e.g., 12)
  currentBookings Int @default(0)

  // Status
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  bookings Booking[]

  @@index([startDate])
  @@index([isActive])
  @@index([isActive, startDate, currentBookings]) // Composite index for getAvailable query
}

// ============================================================================
// BOOKINGS
// ============================================================================

model Booking {
  id               String        @id @default(cuid())
  bookingReference String        @unique // PBP-{YEAR}-{6-DIGIT}
  userId           String
  user             User          @relation(fields: [userId], references: [id])
  packageId        String
  package          Package       @relation(fields: [packageId], references: [id])
  tripId           String?
  trip             Trip?         @relation(fields: [tripId], references: [id])

  status BookingStatus @default(DRAFT)

  // Configuration
  duration           Int    // Days selected (7, 10, 14, 21)
  accommodationTier  String // Luxury, Ultra-Luxury, Villa

  // Pricing
  basePrice          Int // Snapshot of package base price
  accommodationPrice Int // Additional cost for tier
  addOnsTotal        Int // Sum of all add-ons
  totalPrice         Int // Final total price in cents

  // Referral
  referredBy String? // Partner referral code

  // Payment Plan (E4-S6)
  paymentPlan      PaymentPlan @default(FULL)
  stripeCustomerId String? // Stripe customer ID for installment plans

  // Rescheduling
  rescheduleCount Int       @default(0) // Track number of reschedules (max: 1)
  rescheduledAt   DateTime? // Last reschedule timestamp
  originalTripId  String?   // Original trip before reschedule (audit trail)

  // Companion Booking (E3-S17)
  isCompanionBooking  Boolean @default(false) // True if this is a companion booking
  primaryBookingId    String? // References primary booking if this is companion
  accommodationShared Boolean @default(false) // True if sharing room with primary guest

  // Companion Guest Information (E3-S17 Task 9)
  // These fields store companion's information when isCompanionBooking = true
  guestFirstName      String? // Companion's first name
  guestLastName       String? // Companion's last name
  guestEmail          String? // Companion's email (must be unique from primary)
  guestPhone          String? // Companion's phone (optional)
  guestDateOfBirth    String? // Companion's DOB (optional)
  guestPassportNumber String? // Companion's passport number (optional)
  guestDietaryNotes   String? // Companion's dietary restrictions/notes (optional)

  // Gift Booking (E3-S18)
  isGift              Boolean    @default(false) // True if this is a gift booking
  giftPurchaserId     String? // User ID of original purchaser (before transfer)
  giftRecipientEmail  String? // Recipient's email
  giftRecipientName   String? // Recipient's full name
  giftRecipientPhone  String? // Recipient's phone (optional)
  giftMessage         String?    @db.Text // Personal message from purchaser
  giftDeliveryDate    DateTime? // When to send gift notification (null = immediate)
  giftAcceptedAt      DateTime? // When recipient accepted the gift
  giftStatus          GiftStatus @default(PENDING) // PENDING, SENT, ACCEPTED, DECLINED
  giftAcceptanceToken String?    @unique // Unique token for secure gift acceptance

  // E11-S4: Pre-Trip Email Sequence
  preTripEmailsSent String[] @default([]) // ["60_DAYS", "30_DAYS", "14_DAYS", "7_DAYS", "1_DAY"]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  bookingAddOns   BookingAddOn[]
  payments        Payment[]
  paymentRecords  PaymentRecord[] // E4-S6: Installment payment tracking
  documents       Document[]
  referral        PartnerReferral?
  reminderHistory ReminderHistory[]
  tasks           Task[]

  // Companion booking relationships
  primaryBooking    Booking?  @relation("CompanionTo", fields: [primaryBookingId], references: [id], onDelete: SetNull)
  companionBookings Booking[] @relation("CompanionTo")

  @@index([userId])
  @@index([packageId])
  @@index([tripId])
  @@index([bookingReference])
  @@index([status])
  @@index([createdAt])
  @@index([primaryBookingId])
  @@index([giftAcceptanceToken])
  @@index([giftStatus])
  @@index([giftDeliveryDate])
}

model AddOn {
  id          String        @id @default(cuid())
  name        String
  description String?
  category    AddOnCategory

  // Pricing (Thailand vs US comparison)
  thPrice Int // Thailand price in USD cents
  usPrice Int // US price in USD cents (for comparison)

  imageUrl String?
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  bookingAddOns BookingAddOn[]

  @@index([category])
  @@index([isActive])
}

model BookingAddOn {
  id        String @id @default(cuid())
  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  addOnId   String
  addOn     AddOn   @relation(fields: [addOnId], references: [id])

  quantity Int     @default(1) // For things like veneers (multiple teeth)
  price    Int     // Snapshot of price at booking time

  createdAt DateTime @default(now())

  @@unique([bookingId, addOnId])
  @@index([bookingId])
  @@index([addOnId])
}

// ============================================================================
// PAYMENTS
// ============================================================================

model Payment {
  id        String        @id @default(cuid())
  bookingId String
  booking   Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  amount Int // Amount in cents
  status PaymentStatus @default(PENDING)

  // Stripe Integration
  stripePaymentIntentId String? @unique
  stripeCustomerId      String?

  // Installment Plan
  isInstallment   Boolean   @default(false)
  installmentNumber Int?    // 1 of 4, 2 of 4, etc.
  scheduledDate   DateTime? // When installment is due

  // Metadata
  failureReason String? // Error message if payment failed

  // Receipt Generation (E4-S8)
  receiptUrl         String?   // Supabase Storage URL
  receiptNumber      String?   @unique // Format: RCPT-YYYYMMDD-XXXXX
  receiptGeneratedAt DateTime? // When PDF was generated

  // Refund Tracking (E4-S4, E4-S9)
  refundedAmount Int?    // Amount refunded in cents
  stripeRefundId String? // Stripe refund ID (re_...)

  // Relations
  refundLogs RefundLog[] // Detailed refund history (E4-S9)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([bookingId])
  @@index([status])
  @@index([scheduledDate])
  @@index([stripePaymentIntentId])
}

// ============================================================================
// PAYMENT RECORDS (E4-S6 - Installment Tracking)
// ============================================================================

model PaymentRecord {
  id        String              @id @default(cuid())
  bookingId String
  booking   Booking             @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  // Amount and Status
  amountCents Int                 // Payment amount in cents
  status      PaymentRecordStatus @default(PENDING)

  // Installment Details
  dueDate            DateTime  // When this payment is due
  paidDate           DateTime? // When payment was completed
  percentage         Int?      // Percentage of total (50, 25, 15, 10)
  installmentNumber  Int?      // Which installment (1, 2, 3, 4)

  // Stripe Integration
  stripePaymentIntentId String? @unique // Stripe payment intent for this installment

  // E4-S6 Phase 8: Retry Logic
  retryCount     Int      @default(0)  // Track retry attempts (0-3)
  lastAttemptAt  DateTime?             // When last charge was attempted
  failureReason  String?               // Stripe error message for debugging

  // E4-S8: Payment Reminders
  reminderSentAt DateTime?             // When 7-day reminder was sent

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([bookingId])
  @@index([status])
  @@index([dueDate])
  @@index([stripePaymentIntentId])
  @@index([reminderSentAt])
}

// ============================================================================
// APPLICATIONS
// ============================================================================

model Application {
  id     String            @id @default(cuid())
  userId String
  user   User              @relation(fields: [userId], references: [id])

  status ApplicationStatus @default(SUBMITTED)

  // Step 1: Basic Info
  firstName String
  lastName  String
  email     String
  phone     String
  location  String

  // Step 2: Pickleball Background
  pickleballSkillLevel String
  pickleballFrequency  String
  homeClub             String?

  // Step 3: Transformation Interests
  interests String[] // dental, cosmetic, wellness, spiritual, pure_play

  // Step 4: Travel Preferences
  preferredDuration  String   // 7, 10, 14, 21 days
  preferredDates     String?  // Rough timeframe
  travelingAlone     Boolean
  budgetRange        String?  // e.g., "$10-15K"

  // Step 5: Discovery
  referralSource String // How did you hear about us?

  // Admin Notes
  adminNotes String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

// ============================================================================
// TESTIMONIALS
// ============================================================================

model Testimonial {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  // Guest Info (snapshot for display)
  guestName    String
  guestAge     Int?
  guestLocation String?
  packageType  String // Which package they booked
  tripDate     DateTime?

  // Video (Mux integration)
  muxAssetId    String? @unique
  muxPlaybackId String? @unique
  thumbnailUrl  String?

  // Text Testimonial
  quote String? @db.Text

  // Metadata
  isFeatured Boolean  @default(false)
  isApproved Boolean  @default(false)
  viewCount  Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([isFeatured])
  @@index([isApproved])
}

// ============================================================================
// PARTNER REFERRALS
// ============================================================================

model PartnerReferral {
  id        String @id @default(cuid())
  partnerId String
  partner   PartnerProfile @relation(fields: [partnerId], references: [id])
  bookingId String         @unique
  booking   Booking        @relation(fields: [bookingId], references: [id])

  // Points awarded
  pointsEarned Int // Based on booking value

  // Status
  isRedeemed Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([partnerId])
  @@index([bookingId])
}

// E9-S8: Co-Branded Landing Pages
model PartnerLandingPage {
  id          String   @id @default(cuid())
  partnerId   String
  partner     PartnerProfile @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  
  // Basic Info
  name        String
  slug        String   @unique
  isPublished Boolean  @default(false)
  
  // Branding
  clubLogoUrl String?
  primaryColor String?  @default("#003D5C")
  secondaryColor String? @default("#D4AF37")
  
  // Content
  headline    String?
  subheadline String?
  clubContact String?
  
  // Analytics
  viewCount     Int @default(0)
  clickCount    Int @default(0)
  conversionCount Int @default(0)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@index([partnerId])
  @@index([slug])
}

// E9-S11: Payout Management
enum PayoutStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

model PartnerPayout {
  id            String       @id @default(cuid())
  partnerId     String
  partner       PartnerProfile @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  
  // Payout Details
  pointsRedeemed Int         // Points converted to cash
  amountInCents  Int         // Amount in cents ($0.80/point)
  
  // Status
  status        PayoutStatus @default(PENDING)
  
  // Bank Account (masked for display)
  bankAccountLast4 String?
  
  // Processing
  requestedAt   DateTime     @default(now())
  processedAt   DateTime?
  transactionId String?      // External transaction ID
  
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  
  @@index([partnerId])
  @@index([status])
}

model PartnerPayoutMethod {
  id            String   @id @default(cuid())
  partnerId     String   @unique
  partner       PartnerProfile @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  
  // Bank Account (encrypted storage in production)
  bankName      String
  accountNumber String   // TODO: Encrypt in production
  routingNumber String   // TODO: Encrypt in production
  
  // Display
  accountLast4  String   // Last 4 digits for display
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// E9-S13: Directors Circle (Community Forum)
model ForumThread {
  id            String       @id @default(cuid())
  partnerId     String
  partner       PartnerProfile @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  
  // Thread Content
  title         String
  category      ForumCategory
  content       String       @db.Text
  
  // Metadata
  replyCount    Int          @default(0)
  likeCount     Int          @default(0)
  isPinned      Boolean      @default(false)
  isAnnouncement Boolean     @default(false)
  
  // Relationships
  replies       ForumReply[]
  likes         ForumLike[]
  
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  
  @@index([partnerId])
  @@index([category])
  @@index([createdAt])
  @@index([isPinned, createdAt])
}

model ForumReply {
  id            String       @id @default(cuid())
  threadId      String
  thread        ForumThread  @relation(fields: [threadId], references: [id], onDelete: Cascade)
  partnerId     String
  partner       PartnerProfile @relation(fields: [partnerId], references: [id])
  
  content       String       @db.Text
  
  likeCount     Int          @default(0)
  
  // Relationships
  likes         ForumReplyLike[]
  
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  
  @@index([threadId])
  @@index([partnerId])
}

model ForumLike {
  id            String       @id @default(cuid())
  threadId      String
  thread        ForumThread  @relation(fields: [threadId], references: [id], onDelete: Cascade)
  partnerId     String
  partner       PartnerProfile @relation(fields: [partnerId], references: [id])
  
  createdAt     DateTime     @default(now())
  
  @@unique([threadId, partnerId])
  @@index([threadId])
  @@index([partnerId])
}

model ForumReplyLike {
  id            String       @id @default(cuid())
  replyId       String
  reply         ForumReply   @relation(fields: [replyId], references: [id], onDelete: Cascade)
  partnerId     String
  partner       PartnerProfile @relation(fields: [partnerId], references: [id])
  
  createdAt     DateTime     @default(now())
  
  @@unique([replyId, partnerId])
  @@index([replyId])
  @@index([partnerId])
}

// ============================================================================
// COMMUNICATIONS
// ============================================================================

model Notification {
  id     String           @id @default(cuid())
  userId String
  user   User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  type    NotificationType
  title   String
  content String           @db.Text

  // Metadata
  readAt DateTime?

  // Optional link
  linkUrl  String?
  linkText String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([readAt])
  @@index([createdAt])
}

model ReminderHistory {
  id        String   @id @default(cuid())
  bookingId String
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  reminderType String // "30_DAY", "7_DAY", "1_DAY"
  sentAt       DateTime @default(now())
  sentBy       String   // Admin user ID who triggered it

  @@index([bookingId])
  @@index([reminderType])
  @@index([sentAt])
}

// ============================================================================
// DOCUMENTS
// ============================================================================

model Document {
  id         String         @id @default(cuid())
  userId     String         // Clerk user ID
  bookingId  String?        // Optional link to booking
  type       DocumentType
  fileName   String
  fileUrl    String         // Supabase Storage URL
  fileSize   Int            // Bytes
  mimeType   String
  status     DocumentStatus @default(PENDING_REVIEW)
  uploadedAt DateTime       @default(now())
  reviewedAt DateTime?
  reviewedBy String?        // Admin user ID
  notes      String?        // Admin notes

  booking Booking? @relation(fields: [bookingId], references: [id])

  @@index([userId])
  @@index([bookingId])
  @@index([status])
  @@index([uploadedAt])
}

// ============================================================================
// SUPPORT
// ============================================================================

model SupportTicket {
  id        String         @id @default(cuid())
  userId    String
  subject   String
  message   String         @db.Text
  status    TicketStatus   @default(OPEN)
  priority  TicketPriority @default(NORMAL)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

// ============================================================================
// ADMIN / CMS
// ============================================================================

model Message {
  id String @id @default(cuid())

  // Contact Form Data
  name    String
  email   String
  phone   String?
  message String @db.Text

  // Status
  isRead    Boolean   @default(false)
  repliedAt DateTime?

  createdAt DateTime @default(now())

  @@index([isRead])
  @@index([createdAt])
}

// ============================================================================
// WEBHOOK EVENT TRACKING
// ============================================================================

model WebhookEvent {
  id            String   @id @default(cuid())
  stripeEventId String   @unique // Stripe event ID (evt_...)
  type          String   // Event type (charge.refunded, etc.)
  processed     Boolean  @default(true)
  processedAt   DateTime @default(now())
  createdAt     DateTime @default(now())

  @@index([stripeEventId])
  @@index([type])
  @@index([createdAt])
}

// ============================================================================
// REFUND TRACKING (E4-S9)
// ============================================================================

model RefundLog {
  id             String   @id @default(cuid())
  paymentId      String
  payment        Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  amount         Int      // Refund amount in cents
  stripeRefundId String   @unique // Stripe refund ID (re_...)
  reason         String   // RefundReason enum value
  notes          String?  // Admin notes (optional)
  processedBy    String   // Admin user ID (Clerk ID)
  processedAt    DateTime @default(now())

  @@index([paymentId])
  @@index([stripeRefundId])
  @@index([processedAt])
}

// ============================================================================
// TASKS (US-001)
// ============================================================================

model Task {
  id          String       @id @default(cuid())
  title       String
  description String?      @db.Text
  priority    TaskPriority @default(NORMAL)
  status      TaskStatus   @default(PENDING)
  dueDate     DateTime?

  // Relations
  bookingId        String?
  booking          Booking? @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  assignedToUserId String?  // User ID who is assigned this task
  createdByUserId  String   // User ID who created this task (admin)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([bookingId])
  @@index([assignedToUserId])
  @@index([createdByUserId])
  @@index([status])
  @@index([priority])
  @@index([dueDate])
}

// ============================================================================
// NEWSLETTER SUBSCRIBERS (E1-S11)
// ============================================================================

model NewsletterSubscriber {
  id             String           @id @default(cuid())
  email          String           @unique
  firstName      String?          // Optional for single-opt-in
  status         SubscriberStatus @default(PENDING)
  confirmToken   String?          @unique // For double opt-in confirmation
  confirmedAt    DateTime?        // When user confirmed subscription
  subscribedAt   DateTime         @default(now())
  unsubscribedAt DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([email])
  @@index([status])
  @@index([confirmToken])
}
